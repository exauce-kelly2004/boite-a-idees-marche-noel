# ── Boîte mail qui REÇOIT les suggestions
MAIL_DESTINATAIRE=

# ── Compte Gmail qui EXPÉDIE les mails (laisser vide = le même que MAIL_DESTINATAIRE)
GMAIL_COMPTE=
# « Mot de passe d'application » de ce compte Gmail (16 lettres), PAS le mot de passe habituel.
# Pour le créer : https://myaccount.google.com/apppasswords (la validation en deux étapes doit être activée)
GMAIL_MOT_DE_PASSE_APPLI=

# ── Clé secrète des jetons anti-robot (obligatoire, 32 caractères minimum)
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JETON_SECRET=

# ── Adresse publique du site (pour l'aperçu du lien partagé), ex. https://boite-a-idees.vercel.app
SITE_URL=
